{
  "icons": {
    "16": "./gen-assets/icon16.plasmo.png",
    "32": "./gen-assets/icon32.plasmo.png",
    "48": "./gen-assets/icon48.plasmo.png",
    "64": "./gen-assets/icon64.plasmo.png",
    "128": "./gen-assets/icon128.plasmo.png"
  },
  "manifest_version": 3,
  "action": {
    "default_icon": {
      "16": "./gen-assets/icon16.plasmo.png",
      "32": "./gen-assets/icon32.plasmo.png",
      "48": "./gen-assets/icon48.plasmo.png",
      "64": "./gen-assets/icon64.plasmo.png",
      "128": "./gen-assets/icon128.plasmo.png"
    },
    "default_popup": "./popup.html"
  },
  "version": "0.1.0",
  "name": "WingAI — AI-dejtingcoach",
  "description": "Få AI-svarsförslag direkt i Hinge, Tinder och Bumble.",
  "background": {
    "service_worker": "./static/background/index.ts"
  },
  "permissions": [
    "storage",
    "activeTab"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://hinge.co/*"
      ],
      "js": [
        "static\\contents\\hinge.tsx"
      ],
      "all_frames": false
    },
    {
      "matches": [
        "https://tinder.com/*"
      ],
      "js": [
        "static\\contents\\tinder.tsx"
      ],
      "all_frames": false
    }
  ],
  "host_permissions": [
    "https://hinge.co/*",
    "https://tinder.com/*",
    "https://bumble.com/*",
    "https://wingai-umber.vercel.app/*"
  ]
}
